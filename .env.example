# ---- required ----
# MongoDB connection string. The process refuses to start without it.
URI=mongodb://127.0.0.1:27017/aicontact

# ---- optional, shown with their defaults ----
PORT=5000
NODE_ENV=development

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Rate limiting.
# Auth endpoints reject once the ceiling is hit. Safe: released clients stop
# and show a message on failure rather than retrying.
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# Read/update endpoints are throttled by DELAY, not rejection. Released
# clients retry failed calls forever with no backoff, so a 4xx here puts
# installed apps into a hot loop. See docs in src/middlewears/throttle.js.
THROTTLE_AFTER=60
THROTTLE_DELAY_MS=250
THROTTLE_MAX_DELAY_MS=4000
THROTTLE_WINDOW_MS=60000
# Absolute circuit breaker. Far above legitimate use; only trips to protect
# the database, at which point a 429 is the lesser evil.
THROTTLE_HARD_MAX=1200

# =====================================================================
# v2. Nothing below is read unless ENABLE_V2 is true, so a v1-only
# deployment is unaffected by its absence. When v2 IS enabled, every
# required value is checked at boot - a missing Apple key is a startup
# failure rather than a failed purchase.
# =====================================================================
ENABLE_V2=false
ENABLE_APPLE=false
# Apple is opt-in. Leave false for a PayPal-only deployment: Apple credentials
# and APPLE_PRODUCT_IDS are then neither required at boot nor are the Apple
# verification and webhook routes mounted.

# Ignores client writes to subscription_date for accounts that have a
# server-owned entitlement. Released clients still see a success response.
V1_ENTITLEMENT_READONLY=false

# --- tokens ---
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=60
BCRYPT_COST=12
# How long after a rotation a second presentation of the same refresh token is
# read as a concurrent duplicate rather than a replay.
REFRESH_REUSE_GRACE_MS=10000

# --- Apple ---
# From App Store Connect > Users and Access > Integrations > In-App Purchase.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# Contents of the .p8 file. Newlines may be escaped as \n.
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.FaceStreamCorporation.AICONTACT
APPLE_ENVIRONMENT=Production
# Sandbox and TestFlight purchases cost nothing. Leave false in production:
# with it true, anyone who can build the app can unlock the service free.
APPLE_ALLOW_SANDBOX=false
# REQUIRED when v2 is enabled. Comma-separated. An empty list is a refusal,
# not a wildcard - the server will not start without it, and would grant
# nothing if it somehow ran.
APPLE_PRODUCT_IDS=
# Apple's root CA as base64 DER, comma-separated for more than one.
# Download from https://www.apple.com/certificateauthority/ then:
#   openssl x509 -inform DER -in AppleRootCA-G3.cer -outform DER | base64
# There is no default. With this unset, signature verification refuses to
# run rather than trusting an unpinned root.
APPLE_ROOT_CERTS=

# --- PayPal ---
# The ROTATED secret. The one previously committed to the Unity project must
# never be used here.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
# Comma-separated allowlist. A subscription for any other plan is refused.
PAYPAL_PLAN_IDS=
PAYPAL_WEBHOOK_ID=
# Where PayPal returns the customer after approving a server-created
# subscription.
# Supplied per subscription in application_context when the backend creates it,
# so no live PayPal plan edit is required. HTTPS pages, not a deep link.
PAYPAL_RETURN_URL=
PAYPAL_CANCEL_URL=
# Lets customers claim a subscription created before server-side binding
# existed, by confirming a code sent to the PayPal account's own address.
# Turn on only for a supervised migration window, then turn it off.
PAYPAL_LEGACY_CLAIM_ENABLED=false

# --- email ---
# log | resend | postmark. The default only logs; password reset will not
# actually send until a provider is chosen.
MAIL_PROVIDER=log
MAIL_PROVIDER_KEY=
MAIL_FROM=
PASSWORD_RESET_URL_BASE=

# --- remote client configuration (GET /config) ---
PUBLIC_API_BASE_URL=
MIN_CLIENT_VERSION=0.0.0
FORCE_UPGRADE=false
CONFIG_MESSAGE=
# Ed25519 private key in PKCS8 PEM. Generate with:
#   openssl genpkey -algorithm ed25519
CONFIG_SIGNING_KEY=

# --- CORS and request size ---
# v2 only; v1 stays permissive for the released native clients. Requests with
# no Origin - every native client - are unaffected.
CORS_ALLOWED_ORIGINS=
BODY_LIMIT_DEFAULT=100kb
BODY_LIMIT_WEBHOOK=1mb
BODY_LIMIT_ENTITLEMENT=256kb

# --- retention (days) ---
# PLACEHOLDERS pending legal sign-off. See README. These are enforced by a
# periodic job, not merely recorded.
RETENTION_FINANCIAL_DAYS=2555
RETENTION_AUDIT_DAYS=365

# --- v2 rate limits ---
RATE_LIMIT_V2_REGISTER=10
RATE_LIMIT_V2_LOGIN=20
RATE_LIMIT_V2_REFRESH=60
RATE_LIMIT_V2_FORGOT=5
RATE_LIMIT_V2_RESET=10
RATE_LIMIT_V2_DELETE=5
RATE_LIMIT_V2_ENTITLEMENT=30
