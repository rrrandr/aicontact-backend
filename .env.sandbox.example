# PayPal SANDBOX integration only. Never put Live credentials in this file.
#
# Copy to .env.sandbox (already git-ignored) and fill in the two secret
# values yourself. Nothing here is read by the server in normal operation -
# only by the opt-in sandbox integration suite.

# Refuses to run unless this is exactly "sandbox".
PAYPAL_ENV=sandbox

# From the sandbox app "AICONTACT Backend v2 Test":
#   developer.paypal.com > Apps & Credentials > Sandbox > that app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Filled in after the sandbox plan exists (preflight reports the id).
PAYPAL_PLAN_IDS=

# Filled in after a sandbox webhook exists. Until then the webhook parts of
# the suite are skipped rather than silently passing.
PAYPAL_WEBHOOK_ID=

# Where PayPal sends the buyer after approving or cancelling. These do not
# need to resolve for sandbox testing - approval completes regardless.
PAYPAL_RETURN_URL=https://example.com/paypal/return
PAYPAL_CANCEL_URL=https://example.com/paypal/cancel

# Opt-in switch. Without this the integration suite does not run at all.
PAYPAL_SANDBOX_INTEGRATION=1

# Optional override. Phase 2 reads the subscription id phase 1 recorded in
# .paypal-sandbox-state.json, so this is normally left blank. If it is set and
# disagrees with the recorded id, the run refuses rather than guessing.
PAYPAL_TEST_SUBSCRIPTION_ID=
